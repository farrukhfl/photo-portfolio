# Copy to .env.local and fill in.

# Public URL of the site (sitemap, canonicals, OG tags). Both must match.
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB (local instance or free Atlas cluster)
MONGODB_URI=mongodb://127.0.0.1:27017/photography

# Auth for the admin dashboard
JWT_SECRET=change-me-to-a-long-random-string
# Used by `npm run seed` to create/update the single admin account
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me

# Cloudinary (media storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=portfolio
